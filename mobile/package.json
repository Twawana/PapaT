{
  "name": "papat-mobile",
  "version": "1.0.2",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --offline",
    "start:online": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:offline": "expo start --offline",
    "start:localhost": "expo start --localhost",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eas:init": "eas init",
    "eas:login": "powershell -ExecutionPolicy Bypass -File scripts/eas-login.ps1",
    "build:android:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "build:android:store": "npx eas-cli@16.32.0 build --platform android --profile production",
    "submit:android": "npx eas-cli@16.32.0 submit --platform android --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "15.0.3",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-document-picker": "~14.0.8",
    "expo-font": "14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@types/react": "~19.1.0",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "expo-font": "14.0.12",
    "@expo/vector-icons": "15.0.3"
  },
  "private": true
}
