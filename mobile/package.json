{
  "name": "titus-mobile",
  "version": "1.0.2",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --lan --go",
    "start:online": "expo start --lan --go",
    "start:tunnel": "expo start --tunnel --go",
    "start:offline": "expo start --offline --localhost",
    "start:localhost": "expo start --localhost --go",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eas:init": "eas init",
    "eas:login": "powershell -ExecutionPolicy Bypass -File scripts/eas-login.ps1",
    "build:android:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "build:android:store": "npx eas-cli@16.32.0 build --platform android --profile production",
    "submit:android": "npx eas-cli@16.32.0 submit --platform android --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.26",
    "expo-asset": "~58.0.21",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-document-picker": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-screen-orientation": "~58.0.4",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
