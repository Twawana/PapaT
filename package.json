{
  "name": "papat",
  "version": "1.0.0",
  "description": "PapaT — control your PC from your phone",
  "main": "main.js",
  "author": "PapaT",
  "scripts": {
    "postinstall": "npm install --prefix host-server",
    "prestart": "npm run build:host",
    "start": "electron .",
    "build:host": "npm run build --prefix host-server",
    "build:installer": "npm run build:host && electron-builder --win nsis",
    "build:dir": "npm run build:host && electron-builder --dir",
    "prebuild": "npm run build:host",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.papat.app",
    "productName": "PapaT",
    "copyright": "Copyright © PapaT",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "desktop-ui/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "host-server/dist",
        "to": "host-server/dist",
        "filter": ["**/*"]
      },
      {
        "from": "host-server/node_modules",
        "to": "host-server/node_modules",
        "filter": ["**/*"]
      },
      {
        "from": "host-server/package.json",
        "to": "host-server/package.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PapaT",
      "runAfterFinish": true,
      "installerLanguages": ["en_US"],
      "uninstallDisplayName": "PapaT",
      "artifactName": "PapaT-Setup-${version}.${ext}"
    }
  }
}
